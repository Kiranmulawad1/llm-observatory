# Copy to .env and adjust. .env is gitignored and must never be committed.
# In dev/staging/prod these values come from Secret Manager via External Secrets
# (see infra/terraform + infra/k8s), never from a file baked into an image.

# --- Runtime ----------------------------------------------------------------
LO_ENVIRONMENT=local          # local | dev | staging | prod
LO_LOG_LEVEL=INFO
LO_SERVICE_NAME=lo-api

# --- Postgres ---------------------------------------------------------------
# These feed docker-compose; LO_DATABASE_URL is what the apps read.
# Host ports are deliberately off the defaults (5433/6380) so this stack can
# run alongside another project's Postgres/Redis. Container-internal ports are
# still 5432/6379, so the compose service URLs are unaffected.
POSTGRES_USER=lo
POSTGRES_PASSWORD=lo_dev_password
POSTGRES_DB=llm_observatory
POSTGRES_PORT=5433

# Must use the asyncpg driver — config.py rejects anything else, because the
# sync psycopg driver blocks the event loop.
LO_DATABASE_URL=postgresql+asyncpg://lo:lo_dev_password@localhost:5433/llm_observatory
LO_DATABASE_POOL_SIZE=10
LO_DATABASE_MAX_OVERFLOW=5
LO_DATABASE_ECHO=false        # logs query parameters; local only

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6380
LO_REDIS_URL=redis://localhost:6380/0

# --- Security ---------------------------------------------------------------
# Server-side pepper mixed into API key hashes. Rotating it invalidates every
# issued key. The app refuses to start outside `local` while this is the default.
# Platform operator token. Creates projects and issues project API keys, and is
# what the Next.js dashboard holds server-side. `make bootstrap` generates one.
# Required in every deployed environment — without it, project creation would
# have no gate at all.
LO_ADMIN_TOKEN=

LO_API_KEY_PEPPER=dev-only-insecure-pepper

# --- Model providers (optional until Phase 3: embedding + LLM-as-judge) -----
LO_ANTHROPIC_API_KEY=
LO_OPENAI_API_KEY=

# --- Frontend ---------------------------------------------------------------
# Read by Next.js server-side only. Deliberately not NEXT_PUBLIC_*: the API key
# must not be shipped to the browser.
LO_API_BASE_URL=http://localhost:8000
